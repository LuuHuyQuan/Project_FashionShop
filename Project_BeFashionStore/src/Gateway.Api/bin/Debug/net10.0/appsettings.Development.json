{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-variants-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/product-variants/{**catch-all}"
        }
      },
      "ordering-addresses-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/addresses/{**catch-all}"
        }
      },
      "ordering-carts-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/carts/{**catch-all}"
        }
      },
      "ordering-orders-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "ordering-reviews-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "ordering-wishlist-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/wishlist/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5158/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5159/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5160/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
